// dbdiagram.io에 파일 전체를 붙여 넣어 테이블과 관계를 확인한다.
// kind: wp=무기, tech=기술. 화면에 전달할 때 각각 '무기', '기술'로 변환한다.
// 이 파일의 CHECK 표현식은 MySQL 기준이다.
Project conflict_defense_news_dashboard {
  database_type: 'MySQL'
  Note: '''
    분쟁별 방산 무기·기술 보도 대시보드의 최종 테이블 명세.
    기사 한 건은 분쟁 하나에 속하며, 결과는 기사 × 범주당 한 행이다.
    사전의 표준명·유의어는 명칭 하나당 한 행으로 저장한다.
    기사 원문은 크롤링 중 분석하고, DB에는 판정 결과와 근거 문장을 저장한다.
  '''
}

Table conflicts {
  conflict_id varchar(20) [pk, not null, note: '분쟁 고유 ID']
  conflict_name_en varchar(100) [not null, unique, note: '영어 분쟁명']
  conflict_name_ko varchar(100) [not null, unique, note: '한국어 분쟁명']
  color char(7) [not null, note: '#3296ff 형식의 분쟁 대표 색상']
  flag varchar(30) [null, note: '국기 문자. 여러 국기 함께 표시 가능']
  latitude decimal(9,6) [not null, note: '분쟁 사건 발생 위치의 위도']
  longitude decimal(9,6) [not null, note: '분쟁 사건 발생 위치의 경도']
  Note: '분쟁 기준 정보. 위경도는 현재 명세에 포함하지 않는다.'
}

Table articles {
  article_id bigint [pk, not null, increment, note: '프로젝트 내부 기사 ID. GDELT 사건 ID와 구분']
  conflict_id varchar(20) [not null, note: '기사에 지정한 분쟁 ID']
  published_date date [not null, note: '실제 기사 발행일. 기간·월별 보도 집계 기준']
  article_url text [not null, note: '중복 비교 기준에 맞게 정리한 기사 URL']
  title text [not null, note: '기사 제목']
  indexes {
    (conflict_id, published_date) [name: 'idx_articles_conflict_date']
  }
  Note: '''
    러우전쟁·중동전쟁 관련 기사 메타데이터.
    동일 URL의 중복은 신규 데이터와 기존 DB를 비교해 적재 단계에서 제거한다.
    URL의 TEXT 컬럼에는 전체 URL을 보장하지 않는 접두 UNIQUE를 설정하지 않는다.
    발행일이 확인된 기사를 적재하며, GDELT 사건 날짜로 대체하지 않는다.
    제목·본문·수집 시각은 저장하지 않고 GDELT 사건 정보는 별도 CSV로 보관한다.
  '''
}

Table categories {
  category_id varchar(20) [pk, not null, note: '무기·기술 범주 고유 ID']
  kind varchar(20) [not null, note: 'wp: 무기, tech: 기술']
  category_name varchar(100) [not null, note: '대시보드에 표시하는 한국어 범주명']
  indexes {
    (kind, category_name) [unique, name: 'uq_categories_kind_name_ko']
  }
  checks {
    `kind IN ('wp', 'tech')` [name: 'chk_categories_kind']
  }
  Note: '월간 추이·Top 3·범주 선택에서 사용하는 공통 분류.'
}

Table sipri_dictionary {
  wp_id varchar(20) [pk, not null, note: '무기 검색 명칭 행의 고유 ID']
  category_id varchar(20) [not null, note: '해당 명칭이 속한 무기 범주 ID']
  wp_name varchar(255) [not null, unique, note: '영문 표준명 또는 유의어. 한 행에 한 명칭']
  Note: '''
    기사에서 무기 명칭을 탐색하기 위한 사전.
    적재 단계에서 category_id가 kind=wp인 범주인지 검증한다.
    유의어가 별도 행이므로 행 수는 고유 무기 수가 아닌 검색 명칭 수이다.
  '''
}

Table nato_dictionary {
  tech_id varchar(20) [pk, not null, note: '기술 검색 명칭 행의 고유 ID']
  category_id varchar(20) [not null, note: '해당 명칭이 속한 기술 범주 ID']
  tech_name varchar(255) [not null, unique, note: '영문 표준명 또는 유의어. 한 행에 한 명칭']
  Note: '''
    기사에서 기술 명칭을 탐색하기 위한 사전.
    적재 단계에서 category_id가 kind=tech인 범주인지 검증한다.
    유의어가 별도 행이므로 행 수는 고유 기술 수가 아닌 검색 명칭 수이다.
  '''
}

Table usage_patterns {
  pattern_id varchar(20) [pk, not null, note: '표현 고유 ID']
  base_form varchar(20) [not null, note: '동사 원형. 예: use']
  trans_form varchar(20) [not null, note: '동사의 활용형 하나. 예: using 또는 used']
  indexes {
    (base_form, trans_form) [unique, name: 'uq_usage_patterns_forms']
  }
  Note: '''
    사용 여부 판정 프로그램이 참고하는 표현 사전으로 다른 테이블과 FK로 연결하지 않는다.
    원형은 여러 행에 반복될 수 있으며, 활용형 하나당 한 행으로 저장한다.
    탐색할 때 원형과 활용형을 모두 사용하고, 사용 여부는 기사 문맥으로 판정한다.
  '''
}

Table result {
  article_id bigint [not null, note: '판정 대상 기사 ID']
  category_id varchar(20) [not null, note: '기사에서 확인한 무기·기술 범주 ID']
  usage_code int [not null, note: '0: 사용 외 언급, 1: 사용 보도 확인, 2: 확인 필요']
  evidence_sentence text [null, note: '판정 근거 원문 문장. usage_code=1이면 비어 있을 수 없음']
  indexes {
    (article_id, category_id) [pk]
  }
  checks {
    `usage_code IN (0, 1, 2)` [name: 'chk_result_usage_code']
    `usage_code <> 1 OR (evidence_sentence IS NOT NULL AND CHAR_LENGTH(TRIM(evidence_sentence)) > 0)` [name: 'chk_result_usage_evidence']
  }
  Note: '''
    기사 × 범주 단위의 최종 판정 결과.
    동일 기사에서 같은 범주의 여러 명칭이 발견되어도 한 행으로 합친다.
    범주 내 판정은 사용 확인(1), 확인 필요(2), 사용 외 언급(0) 순으로 우선한다.
    사용 확인뿐 아니라 사용 외 언급과 확인 필요 결과도 저장한다.
    크롤링 실패는 사용 외 언급(0)으로 기록하지 않는다.
    전체 분석 기사 수는 article_id의 중복 제거 수이며, 사용 보도는 usage_code=1로 제한한다.
    분쟁 정보는 articles에서 조회하므로 conflict_id를 중복 저장하지 않는다.
  '''
}

// 부모 행을 참조하는 데이터가 있으면 부모의 삭제·ID 변경을 제한한다.
Ref fk_articles_conflict: articles.conflict_id > conflicts.conflict_id [delete: restrict, update: restrict]
Ref fk_sipri_category: sipri_dictionary.category_id > categories.category_id [delete: restrict, update: restrict]
Ref fk_nato_category: nato_dictionary.category_id > categories.category_id [delete: restrict, update: restrict]
Ref fk_result_article: result.article_id > articles.article_id [delete: restrict, update: restrict]
Ref fk_result_category: result.category_id > categories.category_id [delete: restrict, update: restrict]